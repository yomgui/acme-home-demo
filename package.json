{
  "name": "acme-home-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "serve": "tsx server/main.ts",
    "serve:stdio": "tsx server/main.ts --stdio",
    "preview": "tsx tests/host.ts",
    "example": "tsx examples/extend-your-server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:ui:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.12",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
